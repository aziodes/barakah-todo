# Firebase web config. These ship in the client bundle, so they are not
# secrets — access control lives in firestore.rules, not in these values.
#
# The API key is still left blank here rather than committed: GitHub's secret
# scanner flags any Google API key, and an unrestricted key lets anyone call
# Identity Toolkit to create accounts in the project. Fetch it with
#   firebase apps:sdkconfig WEB 1:794537641944:web:e9fae2293a3c7c52bed4ad
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=barakah-todo.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=barakah-todo
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=barakah-todo.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=794537641944
NEXT_PUBLIC_FIREBASE_APP_ID=1:794537641944:web:e9fae2293a3c7c52bed4ad

# Server-only. The full service-account JSON on one line.
# Firebase console -> Project Settings -> Service accounts -> Generate new private key.
FIREBASE_SERVICE_ACCOUNT=

# Your sign-in address. Must match the address hardcoded in firestore.rules.
BARAKAH_OWNER_EMAIL=

# console.anthropic.com -> API Keys. Pay-per-token, separate from Claude Pro.
ANTHROPIC_API_KEY=
# Optional; defaults to claude-sonnet-4-6.
ANTHROPIC_MODEL=

# Shared secret for /api/ingest (n8n + iOS Shortcut).
N8N_SHARED_SECRET=

# Telegram bot credentials for /api/telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
